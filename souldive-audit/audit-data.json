            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Is Soul Dive Water Park currently open to the public?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Soul Dive Water Park is currently under active development and construction in Auraiya, Uttar Pradesh. The park is non-operational at this stage. We are preparing a world-class aquatic experience for our guests. You can register on our website or contact us via WhatsApp to receive official opening announcements as we approach completion."
                }
              },
              {
                "@type": "Question",
                "name": "Where is Soul Dive Water Park located?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The park is located at Biriya, Dibiyapur Road, Auraiya, Uttar Pradesh (PIN: 206122). It is strategically situated along the main Dibiyapur Road corridor, approximately 4 km from Auraiya city center, 12 km from Dibiyapur town, and within easy driving distance from Etawah (52 km via NH-19) and Kanpur Dehat."
                }
              },
              {
                "@type": "Question",
                "name": "What attractions and rides will Soul Dive feature?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Soul Dive will feature a large beach-entry Mega Wave Pool, a central multi-story Waterslide Complex (featuring the Pendulum Ride and Family Raft Slide), an Adult Leisure Pool, a specialized Junior Splash Pool with mushroom fountains and mini-slides, a high-energy Rain Dance Arena, expansive landscaped picnic lawns, a restaurant, and an outdoor shaded caf\u00e9."
                }
              },
              {
                "@type": "Question",
                "name": "When will Soul Dive Water Park open, and what will ticket prices be?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "An official opening date and ticket pricing structure have not been finalized yet. We strictly avoid speculative claims. Accurate ticket prices, timing packages (for adults, children, and students), and launch dates will be publicly announced through our official website and WhatsApp channel once project milestones are achieved."
                }
              },
              {
                "@type": "Question",
                "name": "Will the water park be suitable for young children and families?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, family entertainment is our primary design objective. Soul Dive includes a completely dedicated Kids Pool (0.3m to 0.6m safe shallow depth) with soft-spray water mushrooms and mini-slides, surrounded by dedicated shade cabanas so parents have full visibility of their children at all times."
                }
              },
              {
                "@type": "Question",
                "name": "Is parking available at the venue?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. The park layout includes extensive four-wheeler and two-wheeler parking bays directly outside the main entrance concourse along Dibiyapur Road to ensure convenient, secure guest arrival."
                }
              },
              {
                "@type": "Question",
                "name": "How can I get construction updates and early announcements?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "You can submit your phone number or email through the 'Opening Updates' form on this website, or connect with our official team directly via WhatsApp (+91 94505 71761) to join our VIP early-access notification list."
                }
              }
            ]
          }
        ]
